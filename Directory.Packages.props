    <PackageVersion Include="MimeKitLite" Version="4.18.1" />
    <PackageVersion Include="Texnokaktus.ProgOlymp.Platform" Version="2026.9.19.2" />
    <PackageVersion Include="YandexContestClient" Version="2026.10.27.14" />
